Cell[CellGroupData[{

Cell["Relacion de recurrencia", "Section",
 CellChangeTimes->{{3.9551906863340807`*^9, 
  3.955190702551537*^9}},ExpressionUUID->"54e33568-8fef-4e5e-8143-\
7ab6a3fad6f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RecurrenceTable", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"T", "[", "n", "]"}], "==", " ", 
      RowBox[{
       RowBox[{"T", "[", 
        RowBox[{"n", "-", "1"}], "]"}], "+", 
       RowBox[{"T", "[", 
        RowBox[{"n", "-", "2"}], "]"}], "+", 
       RowBox[{"T", "[", 
        RowBox[{"n", "-", "3"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"T", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"T", "[", "1", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{"T", "[", "2", "]"}], "==", "1"}]}], "}"}], ",", "T", ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "2", ",", "13"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.955190704163574*^9, 3.955190803493259*^9}},
 FontSize->18,
 CellLabel->"In[2]:=",ExpressionUUID->"8c81d583-05bd-4263-ae4a-f273d8dc0146"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "4", ",", "7", ",", "13", ",", "24", ",", "44", ",", 
   "81", ",", "149", ",", "274", ",", "504", ",", "927"}], "}"}]], "Output",
 CellChangeTimes->{{3.955190786770235*^9, 3.955190803968149*^9}},
 CellLabel->"Out[2]=",ExpressionUUID->"82ae6152-a656-49bf-bb14-a0345b382ffa"]
