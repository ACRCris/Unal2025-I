Cell[CellGroupData[{

Cell["Codigo TriboComposiciones[n]", "Section",
 CellChangeTimes->{{3.955190818383429*^9, 
  3.9551908482064734`*^9}},ExpressionUUID->"c3fb6102-f292-495f-b66f-\
1f24e03740a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"estado0", "[", "n_", "]"}], ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"estadoi", "[", 
    RowBox[{"a_", ",", "estado0_"}], "]"}], ":=", " ", 
   RowBox[{"If", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "==", "2"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"estado0", ",", 
         RowBox[{"-", "2"}]}], "]"}], ",", "a"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"estado0", ",", 
         RowBox[{"-", "3"}]}], "]"}], ",", "a"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TriboComposiciones", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"estado", " ", "=", " ", 
        RowBox[{"estado0", "[", "n", "]"}]}], ",", 
       RowBox[{"estadoInt", "=", 
        RowBox[{"estado0", "[", "n", "]"}]}], ",", 
       RowBox[{"composiciones", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"estado0", "[", "n", "]"}], "}"}], "}"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"estado", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "estado", "]"}], "<", "3"}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"estadoInt", ",", "2"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"estado", " ", "=", " ", 
             RowBox[{"estadoi", "[", 
              RowBox[{"3", ",", "estado"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", "estado", "]"}], "<", "n"}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"composiciones", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"composiciones", ",", 
               RowBox[{"Permutations", "[", "estado", "]"}]}], "]"}]}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"estadoInt", "=", "estado"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"estadoInt", ",", "1"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"estadoInt", ",", "1"}], "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"estadoInt", " ", "=", " ", 
                RowBox[{"estadoi", "[", 
                 RowBox[{"2", ",", "estadoInt"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Total", "[", "estadoInt", "]"}], "<", "n"}], ",", 
                 RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"composiciones", "=", 
                RowBox[{"Append", "[", 
                 RowBox[{"composiciones", ",", 
                  RowBox[{"Permutations", "[", "estadoInt", "]"}]}], 
                 "]"}]}]}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"Flatten", "[", 
       RowBox[{"composiciones", ",", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.955190849369698*^9, 3.955191206141224*^9}, {
  3.955191238374091*^9, 3.955191257154705*^9}, {3.955191338390465*^9, 
  3.955191518808671*^9}, {3.955191668936541*^9, 3.955191674367984*^9}, {
  3.955192034852137*^9, 3.955192074350668*^9}, {3.955192117910445*^9, 
  3.955192118675659*^9}, {3.9551921630435553`*^9, 3.955192188592845*^9}, {
  3.9551922389789457`*^9, 3.955192319287634*^9}, {3.955192375706155*^9, 
  3.955192486037518*^9}, {3.955192521109682*^9, 3.955192534979966*^9}, {
  3.9551925690590982`*^9, 3.955192578568343*^9}, {3.955192628691423*^9, 
  3.955192745751568*^9}, {3.95519278857663*^9, 3.955192823590604*^9}, {
  3.9551929110004*^9, 3.9551929562861223`*^9}, {3.955193085705862*^9, 
  3.9551930864840183`*^9}, {3.955193161016254*^9, 3.955193164043878*^9}, {
  3.955193349007778*^9, 3.9551933496347427`*^9}},
 FontSize->18,ExpressionUUID->"a57db0ee-d220-4879-bb8c-c77bca3ec7ee"],

