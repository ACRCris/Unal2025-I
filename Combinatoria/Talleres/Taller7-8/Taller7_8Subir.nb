  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "Hyper[eqn, y[n]] finds at least one hypergeometric \nsolution of the \
homogeneous equation eqn over the field of rational numbers Q \n(provided any \
such solution exists). Hyper[eqn, y[n], Solutions -> All] finds \na \
generating set (not necessarily linearly independent) for the space of \n\
solutions generated by hypergeometric terms over Q. Hyper[eqn, y[n], \n\
Quadratics -> True] finds solutions over quadratic extensions of Q. Solutions \
\ny[n] are given by their rational representations y[n+1]/y[n]. \nWarning: \
The worst-case time complexity of Hyper is exponential \nin the degrees of \
the leading and trailing coefficients of eqn.", "Documentation" -> None, 
    "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[DownValues, Hyper`Hyper, {Hyper`Hyper[
         Pattern[Hyper`Private`eqn, 
          Blank[]], 
         Pattern[Hyper`Private`a, 
          Blank[]][
          Pattern[Hyper`Private`n, 
           Blank[]]], 
         Pattern[Hyper`Private`opts, 
          BlankNullSequence[]]] :> 
       Module[{Hyper`Private`min, Hyper`Private`max, Hyper`Private`dd, 
          Hyper`Private`polyCoeffs, Hyper`Private`m, Hyper`Private`degreePoly,
           Hyper`Private`s = 0, Hyper`Private`d, Hyper`Private`degrees, 
          Hyper`Private`deg, Hyper`Private`sol, Hyper`Private`poly, 
          Hyper`Private`sub, Hyper`Private`k, Hyper`Private`eq, 
          Hyper`Private`degseq, Hyper`Private`lc, Hyper`Private`tc, 
          Hyper`Private`ld, Hyper`Private`td, Hyper`Private`Alist, 
          Hyper`Private`Blist, Hyper`Private`Zlist, Hyper`Private`seq, 
          Hyper`Private`mm, Hyper`Private`pos, Hyper`Private`z, 
          Hyper`Private`exps, Hyper`Private`Atempl, Hyper`Private`Btempl, 
          Hyper`Private`lcoefs, Hyper`Private`powers, Hyper`Private`lhs, 
          Hyper`Private`rhs, Hyper`Private`unknowns, Hyper`Private`i, 
          Hyper`Private`degsa, Hyper`Private`degsb, Hyper`Private`expa, 
          Hyper`Private`expb, Hyper`Private`airr, Hyper`Private`birr, 
          Hyper`Private`aa, Hyper`Private`bb, Hyper`Private`found = {}, 
          Hyper`Private`llc, Hyper`Private`ltc, Hyper`Private`at, 
          Hyper`Private`bt, Hyper`Private`Z, Hyper`Private`A, Hyper`Private`B,
           Hyper`Private`polyeq, Hyper`Private`lca, Hyper`Private`lcb, 
          Hyper`Private`verb, Hyper`Private`verbp, Hyper`Private`verbose, 
          Hyper`Private`solutions, Hyper`Private`quadratics}, 
         Hyper`Private`verbose = ReplaceAll[
            ReplaceAll[Verbose, {Hyper`Private`opts}], 
            Options[Hyper`Hyper]]; Hyper`Private`solutions = ReplaceAll[
            ReplaceAll[RISCComb`Solutions, {Hyper`Private`opts}], 
            Options[Hyper`Hyper]]; Hyper`Private`quadratics = ReplaceAll[
            ReplaceAll[RISCComb`Quadratics, {Hyper`Private`opts}], 
            Options[Hyper`Hyper]]; Hyper`Private`eq = Numerator[
            Together[
             If[
             Head[Hyper`Private`eqn] === Equal, Part[Hyper`Private`eqn, 1] - 
              Part[Hyper`Private`eqn, 2], Hyper`Private`eqn]]]; 
         Hyper`Private`verb = 
          MemberQ[{True, Automatic}, Hyper`Private`verbose]; {
           Hyper`Private`min, Hyper`Private`max} = ({
            Min[#], 
            Max[#]}& )[
            ReplaceAll[
             Map[First, 
              Cases[Hyper`Private`eq, 
               Hyper`Private`a[
                Blank[]], Infinity]], Hyper`Private`n -> 0]]; 
         Hyper`Private`dd = Hyper`Private`max - Hyper`Private`min; 
         Hyper`Private`unknowns = Table[
            Hyper`Private`a[Hyper`Private`n + Hyper`Private`i], {
            Hyper`Private`i, 0, Hyper`Private`dd}]; 
         Hyper`Private`eq = Collect[Hyper`Private`eq, Hyper`Private`unknowns]; 
         Hyper`Private`eq = Map[Factor, 
            ReplaceAll[
            Hyper`Private`eq, Hyper`Private`n -> 
             Hyper`Private`n - Hyper`Private`min]]; 
         Hyper`Private`rhs = -
           Select[Hyper`Private`eq, FreeQ[#, Hyper`Private`a]& ]; 
         Hyper`Private`lhs = Hyper`Private`eq + Hyper`Private`rhs; 
         Hyper`Private`polyCoeffs = Map[Expand[
             Coefficient[Hyper`Private`lhs, #]]& , Hyper`Private`unknowns]; 
         Hyper`Private`m = Max[
            Map[Exponent[#, Hyper`Private`n]& , Hyper`Private`polyCoeffs]]; 
         Hyper`Private`lc = Last[Hyper`Private`polyCoeffs]; 
         Hyper`Private`tc = First[Hyper`Private`polyCoeffs]; 
         Hyper`Private`degseq = 
          Map[Exponent[#, Hyper`Private`n]& , Hyper`Private`polyCoeffs]; 
         Hyper`Private`ld = Last[Hyper`Private`degseq]; 
         Hyper`Private`td = First[Hyper`Private`degseq]; 
         Hyper`Private`powers = 
          Table[Hyper`Private`z^Hyper`Private`i, {
            Hyper`Private`i, 0, Hyper`Private`dd}]; 
         Hyper`Private`lcoefs = Map[Hyper`Private`Coeff[
             Part[#, 1], Hyper`Private`n, 
             Part[#, 2]]& , 
            Thread[{Hyper`Private`polyCoeffs, Hyper`Private`degseq}]]; 
         Hyper`Private`llc = Last[Hyper`Private`lcoefs]; 
         Hyper`Private`ltc = First[Hyper`Private`lcoefs]; 
         If[Hyper`Private`verbose, Print[""]; 
           Print["order = ", Hyper`Private`dd]; 
           Print["lc = ", Hyper`Private`lc]; Print["tc = ", Hyper`Private`tc]; 
           Print["ld = ", Hyper`Private`ld]; Print["td = ", Hyper`Private`td]; 
           Print["degree sequence = ", Hyper`Private`degseq]; 
           Print["leading coeffs = ", Hyper`Private`lcoefs]]; 
         For[Hyper`Private`d = -Hyper`Private`ld, Hyper`Private`d <= 
           Hyper`Private`td, 
           Increment[Hyper`Private`d], 
           Hyper`Private`seq = 
            Hyper`Private`degseq + 
             Table[Hyper`Private`i Hyper`Private`d, {
               Hyper`Private`i, 0, Hyper`Private`dd}]; 
           Hyper`Private`mm = Max[Hyper`Private`seq]; 
           Hyper`Private`pos = Map[First, 
              Position[Hyper`Private`seq, Hyper`Private`mm]]; 
           If[Hyper`Private`verb, Print[""]; 
             Print["d = ", Hyper`Private`d, "; seq = ", Hyper`Private`seq, 
               "; pos = ", Hyper`Private`pos]]; 
           If[Length[Hyper`Private`pos] <= 1, Null, Hyper`Private`zeqn = Dot[
                 Part[Hyper`Private`lcoefs, Hyper`Private`pos], 
                 Part[Hyper`Private`powers, Hyper`Private`pos]] == 0; 
             Hyper`Private`sub = Solve[Hyper`Private`zeqn, Hyper`Private`z]; 
             If[
               Not[
                FreeQ[Hyper`Private`sub, ToRules]], 
               Print[
               "\n Warning: algebraic roots of degree > 4 in characteristic   \
          polynomial;\n some solutions may not be found"]]; 
             Hyper`Private`sub = 
              Select[Hyper`Private`sub, FreeQ[#, ToRules]& ]; 
             Hyper`Private`Zlist = Union[
                If[Hyper`Private`sub === {}, {}, 
                 ReplaceAll[Hyper`Private`z, Hyper`Private`sub]]]; 
             Hyper`Private`Zlist = Complement[Hyper`Private`Zlist, {0}]; 
             If[Hyper`Private`verbose, Print[""]; 
               Print["Zlist = ", Hyper`Private`Zlist]]; 
             For[Hyper`Private`ii = 1, Hyper`Private`ii <= 
               Length[Hyper`Private`Zlist], 
               Increment[Hyper`Private`ii], 
               Hyper`Private`Z = Part[Hyper`Private`Zlist, Hyper`Private`ii]; 
               If[
                 Not[
                  FreeQ[
                   Hyper`Private`Blist[], Hyper`Private`Blist]], 
                 Hyper`Private`bl = If[Hyper`Private`quadratics === True, 
                    Hyper`Private`FactorList2[
                    ReplaceAll[
                    Hyper`Private`lc, Hyper`Private`n -> 
                    Hyper`Private`n - Hyper`Private`dd + 1], Hyper`Private`n], 
                    FactorList[
                    ReplaceAll[
                    Hyper`Private`lc, Hyper`Private`n -> 
                    Hyper`Private`n - Hyper`Private`dd + 1]]]; 
                 Hyper`Private`Blist[] = Select[Hyper`Private`bl, Not[
                    FreeQ[#, Hyper`Private`n]]& ]; 
                 If[Hyper`Private`Blist[] === {}, 
                   Hyper`Private`Blist[] = {{1, 0}}]; 
                 Hyper`Private`birr = Map[First, 
                    Hyper`Private`Blist[]]; 
                 Hyper`Private`degsb = 
                  Map[Exponent[#, Hyper`Private`n]& , Hyper`Private`birr]; 
                 If[Length[
                    Complement[
                    Union[Hyper`Private`degsb], {0, 1}]] > 0, 
                   Print[
                   "\n Warning: irreducible factors of degree > 1 in leading  \
                   coefficient;\n some solutions may not be found"]]; 
                 Hyper`Private`expb = Map[Last, 
                    Hyper`Private`Blist[]]; 
                 Hyper`Private`lcb = Map[Coefficient[
                    Part[#, 1], Hyper`Private`n, 
                    Part[#, 2]]& , 
                    Thread[{Hyper`Private`birr, Hyper`Private`degsb}]]; 
                 Hyper`Private`birr = 
                  Expand[Hyper`Private`birr/Hyper`Private`lcb]; 
                 Hyper`Private`Blist[] = 
                  Thread[{Hyper`Private`birr, Hyper`Private`expb}]; 
                 Hyper`Private`Btempl = 
                  Hyper`Private`Bags[Hyper`Private`expb, Hyper`Private`degsb]; 
                 If[Hyper`Private`verbose, Print[""]; 
                   Print["      Blist = ", 
                    Hyper`Private`Blist[]]]]; If[
                 Not[
                  FreeQ[
                   Hyper`Private`Alist[], Hyper`Private`Alist]], 
                 Hyper`Private`al = If[Hyper`Private`quadratics === True, 
                    Hyper`Private`FactorList2[
                    Hyper`Private`tc, Hyper`Private`n], 
                    FactorList[Hyper`Private`tc]]; 
                 Hyper`Private`Alist[] = Select[Hyper`Private`al, Not[
                    FreeQ[#, Hyper`Private`n]]& ]; 
                 If[Hyper`Private`Alist[] === {}, 
                   Hyper`Private`Alist[] = {{1, 0}}]; 
                 Hyper`Private`airr = Map[First, 
                    Hyper`Private`Alist[]]; 
                 Hyper`Private`degsa = 
                  Map[Exponent[#, Hyper`Private`n]& , Hyper`Private`airr]; 
                 If[Length[
                    Complement[
                    Union[Hyper`Private`degsa], {0, 1}]] > 0, 
                   Print[
                   "\n Warning: irreducible factors of degree > 1 in trailing \
                    coefficient;\n some solutions may not be found"]]; 
                 Hyper`Private`expa = Map[Last, 
                    Hyper`Private`Alist[]]; 
                 Hyper`Private`lca = Map[Coefficient[
                    Part[#, 1], Hyper`Private`n, 
                    Part[#, 2]]& , 
                    Thread[{Hyper`Private`airr, Hyper`Private`degsa}]]; 
                 Hyper`Private`airr = 
                  Expand[Hyper`Private`airr/Hyper`Private`lca]; 
                 Hyper`Private`Alist[] = 
                  Thread[{Hyper`Private`airr, Hyper`Private`expa}]; 
                 Hyper`Private`Atempl = 
                  Hyper`Private`Bags[Hyper`Private`expa, Hyper`Private`degsa]; 
                 If[Hyper`Private`verbose, 
                   Print["      Alist = ", 
                    Hyper`Private`Alist[]]]]; 
               For[Hyper`Private`da = Max[0, Hyper`Private`d], 
                 Hyper`Private`da <= 
                 Min[Hyper`Private`td, Hyper`Private`ld + Hyper`Private`d], 
                 Increment[Hyper`Private`da], 
                 Hyper`Private`db = Hyper`Private`da - Hyper`Private`d; 
                 If[Hyper`Private`verb, Print[""]; 
                   Print["  da = ", Hyper`Private`da, ", ", "db = ", 
                    Hyper`Private`db]]; 
                 Hyper`Private`at = 
                  Part[Hyper`Private`Atempl, Hyper`Private`da + 1]; 
                 Hyper`Private`bt = 
                  Part[Hyper`Private`Btempl, Hyper`Private`db + 1]; 
                 For[Hyper`Private`bb = 1, Hyper`Private`bb <= 
                   Length[Hyper`Private`bt], 
                   Increment[Hyper`Private`bb], 
                   Hyper`Private`B = 
                    Apply[Times, Hyper`Private`birr^
                    Part[Hyper`Private`bt, Hyper`Private`bb]]; 
                   Hyper`Private`bc = ReplaceAll[
                    Apply[
                    Times, Hyper`Private`birr^(Hyper`Private`expb - Part[
                    Hyper`Private`bt, Hyper`Private`bb])], Hyper`Private`n -> 
                    Hyper`Private`n + Hyper`Private`dd - 1]; 
                   For[Hyper`Private`aa = 1, Hyper`Private`aa <= 
                    Length[Hyper`Private`at], 
                    Increment[Hyper`Private`aa], 
                    Hyper`Private`A = 
                    Apply[Times, Hyper`Private`airr^
                    Part[Hyper`Private`at, Hyper`Private`aa]]; 
                    Hyper`Private`ac = 
                    Apply[Times, 
                    Hyper`Private`airr^(Hyper`Private`expa - Part[
                    Hyper`Private`at, Hyper`Private`aa])]; 
                    If[Hyper`Private`verb, Print[""]; 
                    Print["     A = ", Hyper`Private`A, "    B = ", 
                    Hyper`Private`B, "   Z = ", Hyper`Private`Z]]; 
                    Hyper`Private`polyeq = 
                    Module[{
                    Hyper`Private`i, Hyper`Private`j, Hyper`Private`k}, 
                    Join[{Hyper`Private`ltc Hyper`Private`ac Product[
                    ReplaceAll[
                    Hyper`Private`B, Hyper`Private`n -> 
                    Hyper`Private`n + Hyper`Private`k], {
                    Hyper`Private`k, 0, Hyper`Private`dd - 2}]}, 
                    Table[
                    Part[Hyper`Private`polyCoeffs, Hyper`Private`i + 1] 
                    Product[
                    ReplaceAll[
                    Hyper`Private`A, Hyper`Private`n -> 
                    Hyper`Private`n + Hyper`Private`j], {
                    Hyper`Private`j, Hyper`Private`i - 1}] Product[
                    ReplaceAll[
                    Hyper`Private`B, Hyper`Private`n -> 
                    Hyper`Private`n + Hyper`Private`k], {
                    Hyper`Private`k, Hyper`Private`i, Hyper`Private`dd - 2}] 
                    Hyper`Private`Z^Hyper`Private`i, {
                    Hyper`Private`i, Hyper`Private`dd - 1}], {
                    Hyper`Private`llc Hyper`Private`bc Product[
                    ReplaceAll[
                    Hyper`Private`A, Hyper`Private`n -> 
                    Hyper`Private`n + Hyper`Private`j], {
                    Hyper`Private`j, Hyper`Private`dd - 1}] 
                    Hyper`Private`Z^Hyper`Private`dd}]]; 
                    Hyper`Private`polyeq = Map[Expand, Hyper`Private`polyeq]; 
                    If[Hyper`Private`verbose, Print[""]; 
                    Print["    ", Hyper`Private`polyeq]]; 
                    Hyper`Private`verbp = 
                    Switch[Hyper`Private`verbose, True, Automatic, 
                    Blank[], False]; 
                    Hyper`Private`sol = 
                    Hyper`Private`PolyK[Hyper`Private`polyeq, 0, 
                    Hyper`Private`a[Hyper`Private`n], Hyper`Private`verbp]; 
                    If[Hyper`Private`sol === {}, 
                    If[
                    Hyper`Private`verbose, 
                    Print["     No non-zero polynomial                      \
solution."]; Print[""]], 
                    If[Hyper`Private`verb, Print[""]; 
                    Print[" ===> C = ", Hyper`Private`sol]]; 
                    Hyper`Private`sol = Module[{Hyper`Private`i}, 
                    Table[
                    Coefficient[Hyper`Private`sol, 
                    C[Hyper`Private`i]], {Hyper`Private`i, 
                    Count[{Hyper`Private`sol}, 
                    C[
                    Blank[]], Infinity]}]]; 
                    Hyper`Private`sol = 
                    ReplaceAll[
                    Hyper`Private`sol, Hyper`Private`n -> 
                    Hyper`Private`n + 1]/Hyper`Private`sol; 
                    Hyper`Private`sol = 
                    Map[Factor, (Hyper`Private`Z Hyper`Private`A 
                    Hyper`Private`sol)/Hyper`Private`B]; 
                    If[Hyper`Private`solutions === 1, 
                    Return[Hyper`Private`sol]]; 
                    Hyper`Private`found = 
                    Union[Hyper`Private`found, Hyper`Private`sol]]]]]]]]; 
         Return[Hyper`Private`found]]}], "SubValues" -> None, "DefaultValues" -> 
