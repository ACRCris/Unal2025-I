Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"Hyper[eqn, y[n]] finds at least one hypergeometric \
\\nsolution of the homogeneous equation eqn over the field of rational \
numbers Q \\n(provided any such solution exists). Hyper[eqn, y[n], Solutions \
-> All] finds \\na generating set (not necessarily linearly independent) for \
the space of \\nsolutions generated by hypergeometric terms over Q. \
Hyper[eqn, y[n], \\nQuadratics -> True] finds solutions over quadratic \
extensions of Q. Solutions \\ny[n] are given by their rational \
representations y[n+1]/y[n]. \\nWarning: The worst-case time complexity of \
Hyper is exponential \\nin the degrees of the leading and trailing \
coefficients of eqn.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"Hyper", "[", 
                    RowBox[{"Hyper`Private`eqn_", ",", 
                    
                    RowBox[{
                    "Hyper`Private`a_", "[", "Hyper`Private`n_", "]"}], ",", 
                    "Hyper`Private`opts___"}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"Hyper`Private`min", ",", "Hyper`Private`max", 
                    ",", "Hyper`Private`dd", ",", "Hyper`Private`polyCoeffs", 
                    ",", "Hyper`Private`m", ",", "Hyper`Private`degreePoly", 
                    ",", 
                    RowBox[{"Hyper`Private`s", "=", "0"}], ",", 
                    "Hyper`Private`d", ",", "Hyper`Private`degrees", ",", 
                    "Hyper`Private`deg", ",", "Hyper`Private`sol", ",", 
                    "Hyper`Private`poly", ",", "Hyper`Private`sub", ",", 
                    "Hyper`Private`k", ",", "Hyper`Private`eq", ",", 
                    "Hyper`Private`degseq", ",", "Hyper`Private`lc", ",", 
                    "Hyper`Private`tc", ",", "Hyper`Private`ld", ",", 
                    "Hyper`Private`td", ",", "Hyper`Private`Alist", ",", 
                    "Hyper`Private`Blist", ",", "Hyper`Private`Zlist", ",", 
                    "Hyper`Private`seq", ",", "Hyper`Private`mm", ",", 
                    "Hyper`Private`pos", ",", "Hyper`Private`z", ",", 
                    "Hyper`Private`exps", ",", "Hyper`Private`Atempl", ",", 
                    "Hyper`Private`Btempl", ",", "Hyper`Private`lcoefs", ",", 
                    "Hyper`Private`powers", ",", "Hyper`Private`lhs", ",", 
                    "Hyper`Private`rhs", ",", "Hyper`Private`unknowns", ",", 
                    "Hyper`Private`i", ",", "Hyper`Private`degsa", ",", 
                    "Hyper`Private`degsb", ",", "Hyper`Private`expa", ",", 
                    "Hyper`Private`expb", ",", "Hyper`Private`airr", ",", 
                    "Hyper`Private`birr", ",", "Hyper`Private`aa", ",", 
                    "Hyper`Private`bb", ",", 
                    RowBox[{"Hyper`Private`found", "=", 
                    RowBox[{"{", "}"}]}], ",", "Hyper`Private`llc", ",", 
                    "Hyper`Private`ltc", ",", "Hyper`Private`at", ",", 
                    "Hyper`Private`bt", ",", "Hyper`Private`Z", ",", 
                    "Hyper`Private`A", ",", "Hyper`Private`B", ",", 
                    "Hyper`Private`polyeq", ",", "Hyper`Private`lca", ",", 
                    "Hyper`Private`lcb", ",", "Hyper`Private`verb", ",", 
                    "Hyper`Private`verbp", ",", "Hyper`Private`verbose", ",", 
                    "Hyper`Private`solutions", ",", 
                    "Hyper`Private`quadratics"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"Hyper`Private`verbose", "=", 
                    RowBox[{
                    RowBox[{"Verbose", "/.", "\[VeryThinSpace]", 
                    RowBox[{"{", "Hyper`Private`opts", "}"}]}], "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"Options", "[", "Hyper", "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`solutions", "=", 
                    RowBox[{
                    RowBox[{"Solutions", "/.", "\[VeryThinSpace]", 
                    RowBox[{"{", "Hyper`Private`opts", "}"}]}], "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"Options", "[", "Hyper", "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`quadratics", "=", 
                    RowBox[{
                    RowBox[{"Quadratics", "/.", "\[VeryThinSpace]", 
                    RowBox[{"{", "Hyper`Private`opts", "}"}]}], "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"Options", "[", "Hyper", "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`eq", "=", 
                    RowBox[{"Numerator", "[", 
                    RowBox[{"Together", "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Head", "[", "Hyper`Private`eqn", "]"}], "===", 
                    "Equal"}], ",", 
                    RowBox[{
                    
                    RowBox[{"Hyper`Private`eqn", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "-", 
                    
                    RowBox[{"Hyper`Private`eqn", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], ",", "Hyper`Private`eqn"}], 
                    "]"}], "]"}], "]"}]}], ";", 
                    RowBox[{"Hyper`Private`verb", "=", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"True", ",", "Automatic"}], "}"}], ",", 
                    "Hyper`Private`verbose"}], "]"}]}], ";", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"Hyper`Private`min", ",", "Hyper`Private`max"}], 
                    "}"}], "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Min", "[", "#1", "]"}], ",", 
                    RowBox[{"Max", "[", "#1", "]"}]}], "}"}], "&"}], ")"}], 
                    "[", 
                    RowBox[{
                    RowBox[{"First", "/@", 
                    RowBox[{"Cases", "[", 
                    RowBox[{"Hyper`Private`eq", ",", 
                    RowBox[{"Hyper`Private`a", "[", "_", "]"}], ",", 
                    "\[Infinity]"}], "]"}]}], "/.", "\[VeryThinSpace]", 
                    RowBox[{"Hyper`Private`n", "\[Rule]", "0"}]}], "]"}]}], 
                    ";", 
                    RowBox[{"Hyper`Private`dd", "=", 
                    RowBox[{"Hyper`Private`max", "-", "Hyper`Private`min"}]}],
                     ";", 
                    RowBox[{"Hyper`Private`unknowns", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Hyper`Private`a", "[", 
                    RowBox[{"Hyper`Private`n", "+", "Hyper`Private`i"}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"Hyper`Private`i", ",", "0", ",", 
                    "Hyper`Private`dd"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"Hyper`Private`eq", "=", 
                    RowBox[{"Collect", "[", 
                    
                    RowBox[{"Hyper`Private`eq", ",", 
                    "Hyper`Private`unknowns"}], "]"}]}], ";", 
                    RowBox[{"Hyper`Private`eq", "=", 
                    RowBox[{"Factor", "/@", 
                    RowBox[{"(", 
                    RowBox[{"Hyper`Private`eq", "/.", "\[VeryThinSpace]", 
                    RowBox[{"Hyper`Private`n", "\[Rule]", 
                    RowBox[{"Hyper`Private`n", "-", "Hyper`Private`min"}]}]}],
                     ")"}]}]}], ";", 
                    RowBox[{"Hyper`Private`rhs", "=", 
                    RowBox[{"-", 
                    RowBox[{"Select", "[", 
                    RowBox[{"Hyper`Private`eq", ",", 
                    RowBox[{
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"#1", ",", "Hyper`Private`a"}], "]"}], "&"}]}], 
                    "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`lhs", "=", 
                    RowBox[{"Hyper`Private`eq", "+", "Hyper`Private`rhs"}]}], 
                    ";", 
                    RowBox[{"Hyper`Private`polyCoeffs", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Expand", "[", 
                    RowBox[{"Coefficient", "[", 
                    RowBox[{"Hyper`Private`lhs", ",", "#1"}], "]"}], "]"}], 
                    "&"}], ")"}], "/@", "Hyper`Private`unknowns"}]}], ";", 
                    RowBox[{"Hyper`Private`m", "=", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exponent", "[", 
                    RowBox[{"#1", ",", "Hyper`Private`n"}], "]"}], "&"}], 
                    ")"}], "/@", "Hyper`Private`polyCoeffs"}], "]"}]}], ";", 
                    RowBox[{"Hyper`Private`lc", "=", 
                    RowBox[{"Last", "[", "Hyper`Private`polyCoeffs", "]"}]}], 
                    ";", 
                    RowBox[{"Hyper`Private`tc", "=", 
                    RowBox[{"First", "[", "Hyper`Private`polyCoeffs", "]"}]}],
                     ";", 
                    RowBox[{"Hyper`Private`degseq", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Exponent", "[", 
                    RowBox[{"#1", ",", "Hyper`Private`n"}], "]"}], "&"}], 
                    ")"}], "/@", "Hyper`Private`polyCoeffs"}]}], ";", 
                    RowBox[{"Hyper`Private`ld", "=", 
                    RowBox[{"Last", "[", "Hyper`Private`degseq", "]"}]}], ";", 
                    RowBox[{"Hyper`Private`td", "=", 
                    RowBox[{"First", "[", "Hyper`Private`degseq", "]"}]}], 
                    ";", 
                    RowBox[{"Hyper`Private`powers", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    SuperscriptBox["Hyper`Private`z", "Hyper`Private`i"], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"Hyper`Private`i", ",", "0", ",", 
                    "Hyper`Private`dd"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"Hyper`Private`lcoefs", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Hyper`Private`Coeff", "[", 
                    RowBox[{
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], ",", "Hyper`Private`n", ",", 
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}], "]"}], "&"}], ")"}], "/@", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"Hyper`Private`polyCoeffs", ",", 
                    "Hyper`Private`degseq"}], "}"}], "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`llc", "=", 
                    RowBox[{"Last", "[", "Hyper`Private`lcoefs", "]"}]}], ";", 
                    RowBox[{"Hyper`Private`ltc", "=", 
                    RowBox[{"First", "[", "Hyper`Private`lcoefs", "]"}]}], 
                    ";", 
                    RowBox[{"If", "[", 
                    RowBox[{"Hyper`Private`verbose", ",", 
                    RowBox[{
                    RowBox[{"Print", "[", "\"\"", "]"}], ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"order = \"", ",", "Hyper`Private`dd"}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"lc = \"", ",", "Hyper`Private`lc"}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"tc = \"", ",", "Hyper`Private`tc"}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"ld = \"", ",", "Hyper`Private`ld"}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"td = \"", ",", "Hyper`Private`td"}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"degree sequence = \"", ",", 
                    "Hyper`Private`degseq"}], "]"}], ";", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"leading coeffs = \"", ",", 
                    "Hyper`Private`lcoefs"}], "]"}]}]}], "]"}], ";", 
                    RowBox[{"For", "[", 
                    RowBox[{
                    RowBox[{"Hyper`Private`d", "=", 
                    RowBox[{"-", "Hyper`Private`ld"}]}], ",", 
                    
                    RowBox[{"Hyper`Private`d", "\[LessEqual]", 
                    "Hyper`Private`td"}], ",", 
                    RowBox[{"Hyper`Private`d", "++"}], ",", 
                    RowBox[{
                    RowBox[{"Hyper`Private`seq", "=", 
                    RowBox[{"Hyper`Private`degseq", "+", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Hyper`Private`i", " ", "Hyper`Private`d"}], ",", 
                    
                    RowBox[{"{", 
                    
                    RowBox[{"Hyper`Private`i", ",", "0", ",", 
                    "Hyper`Private`dd"}], "}"}]}], "]"}]}]}], ";", 
                    RowBox[{"Hyper`Private`mm", "=", 
                    RowBox[{"Max", "[", "Hyper`Private`seq", "]"}]}], ";", 
                    RowBox[{"Hyper`Private`pos", "=", 
                    RowBox[{"First", "/@", 
                    RowBox[{"Position", "[", 
                    RowBox[{"Hyper`Private`seq", ",", "Hyper`Private`mm"}], 
                    "]"}]}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{"Hyper`Private`verb", ",", 
                    RowBox[{
                    RowBox[{"Print", "[", "\"\"", "]"}], ";", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"d = \"", ",", "Hyper`Private`d", ",", 
                    "\"; seq = \"", ",", "Hyper`Private`seq", ",", 
                    "\"; pos = \"", ",", "Hyper`Private`pos"}], "]"}]}]}], 
                    "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "Hyper`Private`pos", "]"}], 
                    "\[LessEqual]", "1"}], ",", "Null", ",", 
                    RowBox[{
                    RowBox[{"Hyper`Private`zeqn", "=", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"Hyper`Private`lcoefs", "\[LeftDoubleBracket]", 
                    "Hyper`Private`pos", "\[RightDoubleBracket]"}], ".", 
                    
