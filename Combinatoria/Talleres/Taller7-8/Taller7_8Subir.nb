Cell[BoxData[
 RowBox[{
  RowBox[{"PalabrasCatalan", "[", 
   RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "extend", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"extend", "[", 
       RowBox[{"lista_List", ",", "k_Integer"}], "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"k", "==", "n"}], ",", 
        RowBox[{"{", "lista", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"extend", "[", 
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{"lista", ",", "x"}], "]"}], ",", 
              RowBox[{"k", "+", "1"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "1", ",", 
              RowBox[{
               RowBox[{"lista", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "+", "1"}]}], "}"}]}], 
           "]"}], ",", "1"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "==", "0"}], ",", 
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"extend", "[", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", "1"}], "]"}], "//", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"FromDigits", "/@", "#"}], ")"}], "&"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
